{
  "name": "mdlinks",
  "version": "0.1.0",
  "description": "Turn a URL into a rich markdown link: title, description, type, and a screenshot.",
  "type": "module",
  "bin": {
    "mdlinks": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "playwright": "^1.47.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "esbuild@0.28.2": true
  }
}
