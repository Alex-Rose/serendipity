{
  "name": "serendipity-extractor",
  "version": "0.1.0",
  "description": "Captures a URL as a serendipity link record: title, description, category, screenshot.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alex-Rose/serendipity.git",
    "directory": "extractor"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    }
  },
  "bin": {
    "mdlinks": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "postinstall": "playwright install chromium",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "playwright": "^1.47.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "esbuild@0.28.2": true
  }
}
